# Backend environment — copy to backend/.env for local dev (NEVER commit the real .env).
# Full variable reference: docs/architecture.md / master guide Appendix A.

# Core
SECRET_KEY=dev-insecure-key-change-me
# DJANGO_SETTINGS_MODULE defaults to config.settings.dev via manage.py

# Staff TOTP secrets are encrypted at rest under this key (Plan-16 Task 3b).
# DELIBERATELY NOT DERIVED FROM SECRET_KEY: rotating SECRET_KEY logs the whole shop out,
# rotating this one is a background re-encrypt (`manage.py rotate_totp_key`), and tying
# them together would mean never being able to do one without the other.
# Dev has a working insecure default in config/settings/base.py, so this is optional
# locally. PRODUCTION HAS NO DEFAULT — config/settings/prod.py reads it without one and
# the process refuses to start if it is missing. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOTP_ENCRYPTION_KEY=
# Decrypt-only keys during a rotation, newest first. See docs/runbooks/admin-gate.md §6.4.
# TOTP_ENCRYPTION_KEY_FALLBACKS=

# Database — local dev/tests run on Postgres (matches prod + CI).
# Start it first: docker compose -f docker-compose.dev.yml up -d postgres
DATABASE_URL=postgres://toke:toke@localhost:5433/toke

# Redis (docker-compose maps to localhost:6380)
REDIS_URL=redis://localhost:6380/0

# Meilisearch (local dev)
# MEILISEARCH_URL=http://localhost:7700
# MEILI_MASTER_KEY=devmasterkey

# Celery (defaults to REDIS_URL)
# CELERY_BROKER_URL=redis://localhost:6380/1
# CELERY_TASK_ALWAYS_EAGER=false

# Frontend origins (CORS + links in emails)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Email — dev uses console; set these for real Resend delivery
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# RESEND_API_KEY=re_...
# From address must be on the verified Resend sending domain (mg.tokecosmetics.com)
DEFAULT_FROM_EMAIL="Toke Cosmetics <hello@mg.tokecosmetics.com>"

# Media on S3 (unset = local filesystem in dev). Needed for real uploads.
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Brand ---
# Shown on gateway-hosted checkout pages (Flutterwave, PayPal). BRAND_LOGO_URL must be a
# PUBLIC url the gateway can fetch server-side — once the storefront is deployed, point it
# at the committed logo, e.g. https://tokecosmetics.com/logo.png
# BRAND_NAME=Toké Cosmetics
# BRAND_LOGO_URL=

# --- Checkout ---
# How long checkout holds the stock reservation, in minutes (default 30).
# Since Plan-09b this tunes the CARD gateways only — bank transfer is fixed at 24h on the
# gateway class (BankTransferGateway.reservation_ttl_minutes), because a transfer waits on
# staff working hours and 30 minutes would expire it before anyone reads the statement.
# RESERVATION_TTL_MINUTES=30

# --- Payment gateways (Plan-09, reactivated in Plan-14b) ---
# Migration payments/0009 switches the three hybrid gateways back ON: Paystack +
# Flutterwave in NG, PayPal internationally, bank transfer as the fallback everywhere.
# Stripe was DROPPED in Plan-14 and stays inactive — do not set its keys.
#
# Use TEST-mode keys. These are what Plan-14b's certification runs against; NOTHING here
# should ever hold a live key — cutover to live is a separate gated step (Plan-27).
#
# An unset gateway is a valid state: its adapter raises GatewayNotConfigured (503).
# `manage.py check` warns (payments.W001) for any gateway that is ACTIVE in a market but
# missing its keys, and names those markets — after filling these in, that check should be
# quiet. Deactivate a gateway per-country in CountryPaymentGateway if you won't offer it.
#
# Paystack (NG) — the reference we send IS the idempotency key. The inline pop-up uses a
# server-minted access_code, so no public key is needed in the storefront.
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# Flutterwave (NG) — SECRET_HASH is the value you set as the webhook "verif-hash".
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
# FLUTTERWAVE_SECRET_HASH=choose-a-long-random-string
# PayPal (intl) — WEBHOOK_ID is required to verify webhook signatures. The CLIENT_ID also
# goes in the storefront as NEXT_PUBLIC_PAYPAL_CLIENT_ID (it is public by design; the
# SECRET never leaves the backend).
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# Sandbox by default; switch to https://api-m.paypal.com in prod.
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- GIG Logistics (Plan-32a) ---
# Sandbox credentials from GIG; production creds and base URL only at go-live.
# The wallet is PREPAID and debited in full at waybill creation — the threshold is the
# NGN balance below which admins get a top-up alert before fulfilment starts failing.
# GIG_EMAIL=
# GIG_PASSWORD=
# Sandbox by default; switch to https://thirdpartynode.theagilitysystems.com in prod.
# GIG_BASE_URL=https://dev-thirdpartynode.theagilitysystems.com
# GIG_WALLET_ALERT_THRESHOLD=50000
# Where GIG's rider collects parcels — distance from here drives every quote. The
# defaults are the SANDBOX test company's address (Gbagada); go-live MUST set the real
# warehouse coordinates or every customer is quoted from the wrong origin.
# GIG_SENDER_LATITUDE=6.5560
# GIG_SENDER_LONGITUDE=3.3888
# 0=Car 1=Bike 2=Van 3=Truck. Bike is the small-parcel default (pending GIG confirm).
# GIG_VEHICLE_TYPE=1
# Printed on the waybill and read to the rider. PHONE is required by GIG's validator —
# an empty value refuses every capture. Go-live sets the real office values.
# GIG_SENDER_NAME=Toke Cosmetics
# GIG_SENDER_PHONE=+234...
# GIG_SENDER_ADDRESS=Gbagada, Lagos
# GIG_SENDER_LOCALITY=Gbagada

# --- Storefront origin (Plan-14b) ---
# Used ONLY to build the gateway return URL that Flutterwave sends the customer back to
# (<origin>/checkout/return?ref=...). Never derived from a request — a client-supplied
# return URL is an open-redirect vector. Must be the origin the customer actually browses,
# so set it to the preview URL when certifying against a deployed preview.
# STOREFRONT_BASE_URL=http://localhost:3000

# Prod only
# ALLOWED_HOSTS=api.tokecosmetics.com

# --- Admin BFF shared secret (Plan-16 follow-up) ---
# Anti-abuse gate on the two admin endpoints whose only legitimate caller is the admin
# app: /auth/admin-token/ and /admin/staff/invites/accept/. NOT authentication — see
# apps/accounts/bff.py. It makes junk cost a string compare instead of an outbound
# Turnstile siteverify call with a 5s timeout, which is the one cost that could not be
# metered by request volume (staff and attackers share one Vercel egress address).
#
# UNSET = OFF, the same contract TURNSTILE_SECRET has. Must match ADMIN_BFF_SECRET in the
# admin app's Vercel environment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_BFF_SECRET=

# Instant storefront cache flush on CMS writes (apps/cms/revalidate.py). Empty = the
# notifier is off and the storefront's 60s revalidate window covers freshness. Must
# match REVALIDATE_SECRET in the storefront's environment.
# REVALIDATE_SECRET=
