{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--project", "backend", "python", "backend/manage.py", "runserver", "8000"],
      "port": 8000
    },
    {
      "name": "storefront",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "storefront", "run", "dev"],
      "port": 3000
    },
    {
      "name": "storefront-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "storefront", "run", "start"],
      "port": 3000
    }
  ]
}
